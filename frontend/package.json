{
  "name": "agentscope-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "generate-api": "node scripts/generate-api.mjs",
