POSTGRES_DB=agentscope
POSTGRES_USER=agentscope
POSTGRES_PORT=5432
# Set a local password before starting Compose. Do not commit .env.
POSTGRES_PASSWORD=
# Use the same password (URL-encoded) in this URL; export it in your shell.
DATABASE_URL=postgresql+psycopg://agentscope:REPLACE_ME@localhost:5432/agentscope

# Phase 4 API: export these values before starting Uvicorn.
ENVIRONMENT=development
ARTIFACT_ROOT=./artifacts
BENCHMARK_ROOT=./benchmarks
MAX_CONCURRENT_RUNS=2
# Phase 7: public worker count is restricted to 2 or 3; this may lower the ceiling to 2.
MAX_PARALLEL_IMPLEMENTERS=3
# Capacity includes queued and active runs.
MAX_PENDING_RUNS=100
MAX_REQUEST_BYTES=16384
SHUTDOWN_GRACE_SECONDS=30
RUNNER_IMAGE=agentscope-runner:py312

# Phase 5 Compose: use the same password as POSTGRES_PASSWORD, URL-encoded.
# Unlike host DATABASE_URL, this uses the Compose service hostname.
COMPOSE_DATABASE_URL=postgresql+psycopg://agentscope:REPLACE_ME@postgres:5432/agentscope
AGENTSCOPE_WORKSPACE_ROOT=/tmp/agentscope-workspaces
API_PORT=8000
API_CPUS=2
UI_PORT=5173
# Phase 6: optional explicit credential paths; never commit actual auth files.
# Host CLI/API: CODEX_AUTH_FILE=/absolute/private/codex-auth.json
# Host CLI/API: CLAUDE_AUTH_FILE=/absolute/private/claude-auth.json
# Compose provider override (-f docker-compose.providers.yml):
# CODEX_AUTH_SOURCE=/absolute/private/codex-auth.json
# CLAUDE_AUTH_SOURCE=/absolute/private/claude-auth.json
# API-key environment alternatives are supported by the host runner:
# CODEX_API_KEY or OPENAI_API_KEY; ANTHROPIC_API_KEY or CLAUDE_CODE_OAUTH_TOKEN.
# For host Vite development, optional: API_PROXY_TARGET=http://127.0.0.1:8000
